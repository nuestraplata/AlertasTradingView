# Plantilla de variables de entorno.
# Copiala como .env.local (local) y cargá los mismos valores en Vercel.
# Este archivo NO lleva valores reales.

# --- Fase 1 ---
# Supabase → Project Settings → API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (formato sb_publishable_...). Se puede usar en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Fase 2: webhook ---
# Clave SECRETA de Supabase (formato sb_secret_...), misma pantalla que la
# publishable. SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Clave que TradingView manda en el campo "clave" de la alerta. Mínimo 24
# caracteres; generala con el comando del README (sección Variables de F2).
WEBHOOK_CLAVE=

# --- Fases siguientes (todavía no hacen falta) ---
# F2.5: secreto con el que Vercel llama al cron diario.
# CRON_SECRET=
# F3: token con el que EasyTrading se autentica contra la API.
# EASYTRADING_TOKEN=
